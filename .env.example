# Database — PostgreSQL
# วิธีรันด้วย Docker:
#   docker run -d --name pattani_pg \
#     -e POSTGRES_USER=pattani \
#     -e POSTGRES_PASSWORD=<STRONG_PASSWORD> \
#     -e POSTGRES_DB=pattani_ticket \
#     -p 127.0.0.1:5435:5432 postgres:16-alpine
DATABASE_URL="postgresql://pattani:CHANGE_ME@localhost:5435/pattani_ticket?schema=public"

# Session — secret สำหรับ sign JWT cookie ของระบบจองตั๋ว (ห้ามแชร์)
# วิธีสร้าง: openssl rand -base64 32
SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"
ADMIN_SESSION_SECRET=""
CUSTOMER_SESSION_SECRET=""
OAUTH_STATE_SECRET=""
RATE_LIMIT_KEY_SECRET=""
# Optional one-release compatibility window (ISO-8601 UTC). Keep this short,
# e.g. 24 hours, then remove it after old cookies have been replaced.
LEGACY_SESSION_ACCEPT_UNTIL=""

# ThaiBulkSMS SMS OTP — เก็บเฉพาะฝั่ง server ห้ามใช้ NEXT_PUBLIC_ prefix
THAIBULKSMS_OTP_KEY=""
THAIBULKSMS_OTP_SECRET=""

# Cloudflare Turnstile — กัน bot หน้า Register โดยไม่เสีย SMS credit
# ระบบจะเปิดใช้เมื่อกำหนดครบทั้ง 2 ค่าเท่านั้น
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
TURNSTILE_ALLOWED_HOSTNAMES="pattanifc.co,www.pattanifc.co"

# Seed admin (ใช้ตอน seed script ครั้งแรกเท่านั้น)
SEED_ADMIN_EMAIL="admin@ticket-online.local"
SEED_ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"

# Payload CMS secret (สำหรับเข้ารหัส JWT/auth ของ CMS)
PAYLOAD_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"
PAYLOAD_ALLOW_SCHEMA_PUSH="false"
CMS_SUPER_ADMIN_EMAIL=""

# ─── OAuth: Google + LINE ─────────────────────────────────────
# ใช้สำหรับปุ่ม "สมัคร/เข้าสู่ระบบด้วย Google" และ "ด้วย LINE"
# ถ้าเว้นว่างจะซ่อนปุ่มโดยอัตโนมัติ (ระบบทำงานได้ตามปกติแค่ไม่มี social login)

# URL base ของแอป — ใช้ประกอบ redirect URI ที่ต้อง register ตรงกับ provider
# local:  http://localhost:3000
# prod:   https://pattanifc.co
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth 2.0 Client
# ขั้นตอน:
# 1) เข้า https://console.cloud.google.com/apis/credentials
# 2) Create Credentials → OAuth client ID → Web application
# 3) Authorised redirect URIs: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# LINE Login Channel (v2.1)
# ขั้นตอน:
# 1) เข้า https://developers.line.biz/console/
# 2) สร้าง Provider → Channel → LINE Login
# 3) Callback URL: {NEXT_PUBLIC_APP_URL}/api/auth/line/callback
# 4) เปิด scope: profile, openid, email (email ต้องขอ approve จาก LINE)
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""

# LINE Messaging API (ไม่ใช่ LINE Login) — ใช้ตรวจ webhook และส่งข้อความจาก OA
LINE_MESSAGING_CHANNEL_SECRET=""
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=""

# Beam Charge API (server-only)
BEAM_MERCHANT_ID=""
BEAM_API_KEY=""

# Base64 HMAC key shown in Beam Lighthouse > Developers > Webhooks (server-only)
BEAM_WEBHOOK_HMAC_KEY=""

# Shop checkout stays closed until real payment details and stock reservation
# are configured. Never place placeholder receiving accounts in application code.
SHOP_CHECKOUT_ENABLED="false"
SHOP_PROMPTPAY_ID=""
SHOP_BANK_NAME=""
SHOP_BANK_ACCOUNT=""
SHOP_BANK_ACCOUNT_NAME=""
SHOP_ORDER_ACCESS_SECRET=""

# Required in production (stable secret of at least 32 bytes) for short-lived
# season-pass barcode image URLs. Development/test may leave it blank and use
# a domain-separated key derived from SESSION_SECRET.
SEASON_BARCODE_ACCESS_SECRET=""
SEASON_GATE_TOKEN_SECRET=""
# Temporary migration switch for already-printed sequential barcodes. Keep
# false for secure gate validation; enable only during a short supervised rollout.
SEASON_PASS_ACCEPT_LEGACY_GATE_CODES="false"
